# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Server
PORT=8080
LOG_LEVEL=info
# Comma-separated allowed CORS origins
ORIGIN=http://localhost:5173

# Quickwit
QUICKWIT_URL=http://localhost:7280
# Optional: separate endpoint for ingest/indexing requests. Also where the MCP
# `indexing_status` tool is sent — /api/v1/indexing only exists on a node running
# the indexer service and 404s on a searcher.
QUICKWIT_INDEXER_URL=

# Max documents per CSV export
MAX_EXPORT_DOCS=10000

# Quickwit index used to store saved queries
VITE_SAVED_QUERIES_INDEX=qwui

# OIDC authentication (set OIDC_ENABLED=true to turn on)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback
# Where the provider sends the user back after a logout. Leave empty to skip
# the parameter. Must be registered as a valid post-logout redirect URI on the
# provider side, or it will reject the logout request.
OIDC_POST_LOGOUT_REDIRECT_URL=http://localhost:5173/

# Cookie session secret — required when OIDC_ENABLED=true
SESSION_SECRET=

# ── MCP endpoint (read-only Quickwit access for AI agents) ───────────────────
# Serves Streamable HTTP MCP at /mcp. Off by default.
MCP_ENABLED=false

# Comma-separated bearer tokens. REQUIRED when MCP_ENABLED=true: with none set
# the endpoint is not mounted at all, because an unauthenticated tool that can
# read every log line in the cluster is worse than a missing feature.
# Generate with: openssl rand -hex 32
#
# Prefer `name:secret` — the name is what appears in the audit log and the
# metrics labels, so "which agent ran this query" has a readable answer, and one
# agent can be revoked without disturbing the others. The secret is never logged.
#   MCP_TOKENS=claude-code:9f3a…,ci-bot:7b21…
# A bare secret still works and is audited as token-1, token-2, …
MCP_TOKENS=

# Host header allowlist (MCP mandates Host/Origin validation against DNS
# rebinding). Left empty, localhost plus the hostnames in OIDC_REDIRECT_URL and
# ORIGIN are allowed — enough for both local development and a normal ingress.
# Set explicitly if qwui is reached on a hostname neither of those mentions.
# MCP_ALLOWED_HOSTS=qwui.example.com,localhost

# Origin header allowlist. Empty means Origin is not checked, which is right for
# agents (they send none); set it only if browser clients will call /mcp.
# MCP_ALLOWED_ORIGINS=

# Ceiling on documents any single search_logs call may return, whatever the
# caller asks for. Keeps a tool result from swallowing an agent's context.
# MCP_MAX_HITS=50

# Tool calls allowed per token per minute. The concurrency limiter protects
# Quickwit at any instant; this stops an agent stuck in a loop from keeping the
# searcher saturated all day. A normal investigation is a handful of calls.
# MCP_RATE_LIMIT_PER_MIN=120

# Serve Prometheus metrics at /metrics. Off by default: the endpoint is
# unauthenticated so an in-cluster Prometheus can scrape it, which makes it a
# footgun behind a catch-all ingress. It carries no query text and no
# credentials, but it does name the configured agents — block the path at the
# ingress if "/" is publicly routed.
# METRICS_ENABLED=true

# Simultaneous requests MCP may have in flight against Quickwit. Left unset it
# is derived at startup from what Quickwit reports about itself (`num_cpus` and
# `max_num_concurrent_split_searches`) — check the startup log for the value and
# where it came from. Set this only to override that.
# MCP_MAX_CONCURRENT_REQUESTS=4

# Whether the session cookie carries the `Secure` attribute. Left unset, it is
# inferred from OIDC_REDIRECT_URL: on for https://, off for local http development.
# Set explicitly only when the app is served over HTTPS by a proxy but
# OIDC_REDIRECT_URL does not reflect it.
# SESSION_COOKIE_SECURE=true
